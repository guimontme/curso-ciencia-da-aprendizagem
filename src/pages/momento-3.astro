---
import Layout from '../layouts/Layout.astro';
import Semana from '../components/commons/Semana.astro';
import Box from '../components/commons/Box.astro';
import ForumLink from '../components/commons/ForumLink.astro';
import ModalVerbete from '../components/commons/ModalVerbete.astro';
import ModalSaibaMais from '../components/commons/ModalSaibaMais.astro';
import iconeObjetivo from '../assets/imgs/icone-objetivo.svg';
import iconeAula from '../assets/imgs/icone-aula.svg';
import iconeInfos from '../assets/imgs/icone-infos.svg';
import iconeMaisConteudo from '../assets/imgs/icone-mais-conteudo.svg';
import iconeBoasvindas from '../assets/imgs/icone-boasvindas.svg';
import DecoArco from '../components/commons/DecoArco.astro';
---

<Layout title="Momento 3" secao="momento-3">
    <div class="secao-wrapper">
        <div class="secao-card">
            <div class="secao-titulo">
                <div class="secao-titulo-icone">
                    <img src={iconeBoasvindas.src} alt="" />
                </div>
                <h1>Momento 3</h1>
            </div>

            <div class="secao-content">
                <p>
                    Neste terceiro momento vamos abordar o
                    <a href="#" class="link-verbete" data-bs-toggle="modal" data-bs-target="#verbete-tdah">TDAH — Transtorno do Déficit de Atenção e Hiperatividade</a>:
                    suas características, impactos no aprendizado e como criar um ambiente escolar mais
                    favorável para esses estudantes.
                </p>

                <!-- SEMANA 1 -->
                <Semana numero={1} collapseId="s1m3" aberta={true}>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeObjetivo.src} alt="" /></span>
                            <span class="subsecao-titulo">Objetivos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <ul>
                                <li>Identificar as características do TDAH — desatenção, hiperatividade e impulsividade;</li>
                                <li>Diferenciar o TDAH de outros comportamentos típicos da infância/adolescência;</li>
                                <li>Compreender como o TDAH afeta o desempenho escolar.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeAula.src} alt="" /></span>
                            <span class="subsecao-titulo-aula">Aula 1 - O que é o TDAH? Características, subtipos e impactos no cotidiano</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div style="display:flex; justify-content:center; margin:14px 0;">
                                <div style="width:100%; max-width:680px; aspect-ratio:16/9; border-radius:6px; overflow:hidden;">
                                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dFdy_GmFTvQ" title="Vídeo — Aula" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="display:block;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeMaisConteudo.src} alt="" /></span>
                            <span class="subsecao-titulo">Mais conteúdo</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <a href="#" class="link-material">Nota Técnica SEESP/GAB/Nº 9/2010 — TDAH e Educação</a>
                            <br/>
                            <a href="#" class="link-material-outline" style="margin-top:6px; display:inline-flex;"
                                data-bs-toggle="modal" data-bs-target="#saibamais-mitos">
                                Mitos e verdades sobre o TDAH
                            </a>
                        </div>
                    </div>

                </Semana>

                <!-- SEMANA 2 -->
                <Semana numero={2} collapseId="s2m3" aberta={false}>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeObjetivo.src} alt="" /></span>
                            <span class="subsecao-titulo">Objetivos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <ul>
                                <li>Conhecer estratégias de gestão de sala de aula para estudantes com TDAH;</li>
                                <li>Compreender a importância da estrutura e da rotina previsível;</li>
                                <li>Explorar técnicas para aumentar o engajamento e reduzir distrações.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeAula.src} alt="" /></span>
                            <span class="subsecao-titulo-aula">Aula 2 - Gestão de sala de aula inclusiva para estudantes com TDAH</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div style="display:flex; justify-content:center; margin:14px 0;">
                                <div style="width:100%; max-width:680px; aspect-ratio:16/9; border-radius:6px; overflow:hidden;">
                                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dFdy_GmFTvQ" title="Vídeo — Aula" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="display:block;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeInfos.src} alt="" /></span>
                            <span class="subsecao-titulo">Infos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div class="info-strip">
                                <div class="info-icone"><img src={iconeInfos.src} alt="" /></div>
                                <div>
                                    Intervalos regulares, instrução multimodal e feedback imediato são as
                                    estratégias mais eficazes para manter o engajamento de estudantes com TDAH.
                                </div>
                            </div>
                        </div>
                    </div>

                </Semana>

                <!-- SEMANA 3 -->
                <Semana numero={3} collapseId="s3m3" aberta={false}>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeObjetivo.src} alt="" /></span>
                            <span class="subsecao-titulo">Objetivos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <ul>
                                <li>Compreender como avaliar de forma inclusiva estudantes com TDAH;</li>
                                <li>Identificar adaptações de provas e instrumentos avaliativos;</li>
                                <li>Valorizar a autoavaliação como ferramenta de aprendizagem.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeAula.src} alt="" /></span>
                            <span class="subsecao-titulo-aula">Aula 3 - Avaliação inclusiva para estudantes com TDAH: adaptações e instrumentos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div style="display:flex; justify-content:center; margin:14px 0;">
                                <div style="width:100%; max-width:680px; aspect-ratio:16/9; border-radius:6px; overflow:hidden;">
                                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dFdy_GmFTvQ" title="Vídeo — Aula" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="display:block;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <Box titulo="Prazo da atividade: XX/XX/XXXX">
                        <p>
                            Realize a atividade avaliativa do Momento 3.
                            Acesse a <a href="/avaliacao-modulo" style="color:#465627;font-weight:700;">Avaliação do módulo</a>.
                        </p>
                    </Box>

                </Semana>

                <div class="mt-3">
                    <ForumLink href="#" titulo="Fórum de discussão — Momento 3" />
                </div>
            </div>
        </div>
    </div>

    <ModalVerbete id="verbete-tdah" titulo="TDAH — Transtorno do Déficit de Atenção e Hiperatividade">
        <p>
            O <strong>TDAH</strong> é um transtorno do neurodesenvolvimento caracterizado por padrões
            persistentes de desatenção e/ou hiperatividade-impulsividade que interferem no funcionamento
            ou no desenvolvimento da pessoa.
        </p>
        <p>
            Existem três apresentações: predominantemente desatento, predominantemente
            hiperativo-impulsivo e combinado. Os sintomas devem estar presentes antes dos 12 anos e
            em pelo menos dois contextos (ex.: escola e casa).
        </p>
    </ModalVerbete>

    <ModalSaibaMais id="saibamais-mitos" titulo="Mitos e verdades sobre o TDAH">
        <h3>Mito: TDAH é falta de disciplina</h3>
        <p><strong>Verdade:</strong> É um transtorno neurobiológico com base genética comprovada.</p>
        <h3>Mito: Crianças com TDAH nunca se concentram</h3>
        <p><strong>Verdade:</strong> Podem apresentar hiperfoco em atividades de alto interesse.</p>
        <h3>Mito: TDAH some na adolescência</h3>
        <p><strong>Verdade:</strong> Os sintomas de desatenção frequentemente persistem na vida adulta.</p>
    </ModalSaibaMais>
</Layout>
