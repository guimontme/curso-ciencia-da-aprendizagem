---
import Layout from '../layouts/Layout.astro';
import Semana from '../components/commons/Semana.astro';
import Box from '../components/commons/Box.astro';
import ForumLink from '../components/commons/ForumLink.astro';
import ModalVerbete from '../components/commons/ModalVerbete.astro';
import ModalSaibaMais from '../components/commons/ModalSaibaMais.astro';
import iconeObjetivo from '../assets/imgs/icone-objetivo.svg';
import iconeAula from '../assets/imgs/icone-aula.svg';
import iconeInfos from '../assets/imgs/icone-infos.svg';
import iconeMaisConteudo from '../assets/imgs/icone-mais-conteudo.svg';
import iconeBoasvindas from '../assets/imgs/icone-boasvindas.svg';
import DecoArco from '../components/commons/DecoArco.astro';
---

<Layout title="Momento 4" secao="momento-4">
    <div class="secao-wrapper">
        <div class="secao-card">
            <div class="secao-titulo">
                <div class="secao-titulo-icone">
                    <img src={iconeBoasvindas.src} alt="" />
                </div>
                <h1>Momento 4</h1>
            </div>

            <div class="secao-content">
                <p>
                    No quarto e último momento do módulo, vamos trabalhar com o
                    <a href="#" class="link-verbete" data-bs-toggle="modal" data-bs-target="#verbete-dua">Desenho Universal para a Aprendizagem (DUA)</a>
                    como uma abordagem proativa para criar ambientes de aprendizagem mais flexíveis,
                    acessíveis e eficazes para <em>todos</em> os estudantes.
                </p>

                <!-- SEMANA 1 -->
                <Semana numero={1} collapseId="s1m4" aberta={true}>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeObjetivo.src} alt="" /></span>
                            <span class="subsecao-titulo">Objetivos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <ul>
                                <li>Compreender os três princípios do DUA: representação, ação/expressão e engajamento;</li>
                                <li>Relacionar o DUA à diversidade presente nas turmas comuns;</li>
                                <li>Identificar práticas pedagógicas alinhadas ao DUA no cotidiano escolar.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeAula.src} alt="" /></span>
                            <span class="subsecao-titulo-aula">Aula 1 - Desenho Universal para a Aprendizagem: princípios e fundamentos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div style="display:flex; justify-content:center; margin:14px 0;">
                                <div style="width:100%; max-width:680px; aspect-ratio:16/9; border-radius:6px; overflow:hidden;">
                                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dFdy_GmFTvQ" title="Vídeo — Aula" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="display:block;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeMaisConteudo.src} alt="" /></span>
                            <span class="subsecao-titulo">Mais conteúdo</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <a href="#" class="link-material">Diretrizes do DUA — CAST (2018)</a>
                            <br/>
                            <a href="#" class="link-material-outline" style="margin-top:6px; display:inline-flex;"
                                data-bs-toggle="modal" data-bs-target="#saibamais-dua-pratica">
                                Como aplicar o DUA na prática?
                            </a>
                        </div>
                    </div>

                </Semana>

                <!-- SEMANA 2 -->
                <Semana numero={2} collapseId="s2m4" aberta={false}>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeObjetivo.src} alt="" /></span>
                            <span class="subsecao-titulo">Objetivos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <ul>
                                <li>Planejar uma aula ou sequência didática com base nos princípios do DUA;</li>
                                <li>Incorporar múltiplos meios de representação e expressão;</li>
                                <li>Avaliar de forma flexível e inclusiva.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeAula.src} alt="" /></span>
                            <span class="subsecao-titulo-aula">Aula 2 - Aplicando o DUA no planejamento de aulas inclusivas</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div style="display:flex; justify-content:center; margin:14px 0;">
                                <div style="width:100%; max-width:680px; aspect-ratio:16/9; border-radius:6px; overflow:hidden;">
                                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dFdy_GmFTvQ" title="Vídeo — Aula" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="display:block;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeInfos.src} alt="" /></span>
                            <span class="subsecao-titulo">Infos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div class="info-strip">
                                <div class="info-icone"><img src={iconeInfos.src} alt="" /></div>
                                <div>
                                    Na Semana 2, você vai desenvolver um <strong>plano de aula com DUA</strong>
                                    para uma turma real ou fictícia. Esse plano será o insumo principal para
                                    a atividade avaliativa do Momento 4.
                                </div>
                            </div>
                        </div>
                    </div>

                </Semana>

                <!-- SEMANA 3 -->
                <Semana numero={3} collapseId="s3m4" aberta={false}>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeObjetivo.src} alt="" /></span>
                            <span class="subsecao-titulo">Objetivos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <ul>
                                <li>Integrar os conhecimentos dos Momentos 1, 2 e 3 na perspectiva do DUA;</li>
                                <li>Refletir sobre os avanços e desafios da educação inclusiva na sua realidade;</li>
                                <li>Construir um olhar propositivo para a transformação da escola.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="subsecao">
                        <div class="subsecao-cabecalho">
                            <span class="subsecao-icone"><img src={iconeAula.src} alt="" /></span>
                            <span class="subsecao-titulo-aula">Aula 3 - Síntese do módulo: DUA, TEA, TDAH e a escola que queremos</span>
                            <DecoArco />
                        </div>
                        <div class="subsecao-corpo">
                            <div style="display:flex; justify-content:center; margin:14px 0;">
                                <div style="width:100%; max-width:680px; aspect-ratio:16/9; border-radius:6px; overflow:hidden;">
                                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dFdy_GmFTvQ" title="Vídeo — Aula" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="display:block;"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>

                    <Box titulo="Última atividade — prazo: XX/XX/XXXX">
                        <p>
                            Após concluir este Momento, realize a
                            <a href="/avaliacao-modulo" style="color:#465627;font-weight:700;">Avaliação do módulo</a>
                            e verifique os requisitos para a
                            <a href="/certificacao-encerramento" style="color:#465627;font-weight:700;">certificação</a>.
                        </p>
                    </Box>

                </Semana>

                <div class="mt-3">
                    <ForumLink href="#" titulo="Fórum de discussão — Momento 4" />
                </div>
            </div>
        </div>
    </div>

    <ModalVerbete id="verbete-dua" titulo="DUA — Desenho Universal para a Aprendizagem">
        <p>
            O <strong>DUA</strong> é uma estrutura pedagógica baseada em neurociência que propõe o
            planejamento proativo de currículos, ambientes e avaliações flexíveis para todos os estudantes.
        </p>
        <p>
            Três princípios: <strong>Múltiplos meios de representação</strong> (oferecer o conteúdo de
            formas variadas); <strong>Múltiplos meios de ação e expressão</strong> (diferentes formas de
            demonstrar o aprendizado); <strong>Múltiplos meios de engajamento</strong> (motivar pela
            relevância e escolha).
        </p>
    </ModalVerbete>

    <ModalSaibaMais id="saibamais-dua-pratica" titulo="Aplicando o DUA na prática">
        <h3>Exemplos de aplicação</h3>
        <ul>
            <li><strong>Representação:</strong> apresentar um conceito com texto, imagem E vídeo;</li>
            <li><strong>Expressão:</strong> permitir resposta escrita, oral ou desenhada;</li>
            <li><strong>Engajamento:</strong> oferecer temas relacionados à vida do estudante;</li>
            <li><strong>Avaliação:</strong> admitir portfólio, apresentação ou texto.</li>
        </ul>
    </ModalSaibaMais>
</Layout>
