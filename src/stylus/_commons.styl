// ============================================================
// Course banner — real image
// ============================================================
.course-banner-wrapper {
  max-width: 1560px;
  margin: 0 auto;
  overflow: hidden;
  display: block;
  line-height: 0;

  .course-banner-full {
    width: 100%;
    height: auto;
    display: block;
  }
}

// ============================================================
// Link Verbete (trigger glossário)
// ============================================================
.link-verbete {
  color: azul;
  font-weight: 700;
  text-decoration: none;
  border-bottom: 2px dotted azul;
  cursor: pointer;
  padding-bottom: 1px;

  &::after {
    content: 'ⓘ';
    font-size: 0.75em;
    margin-left: 3px;
    vertical-align: super;
    font-weight: 400;
  }

  &:hover {
    color: darken(azul, 12%);
    border-bottom-style: solid;
  }
}

// ============================================================
// Link Saiba Mais (trigger modal info)
// ============================================================
.link-saibamais {
  color: verde;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;

  &::after {
    content: '⊕';
    font-size: 0.9em;
    margin-left: 4px;
    vertical-align: middle;
  }

  &:hover {
    color: verde-escuro;
    text-decoration: underline;
  }
}

// ============================================================
// Modal Verbete (blue)
// ============================================================
.modal-verbete {
  .modal-dialog {
    max-width: 560px;
  }

  .modal-content {
    border: none;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  }

  .modal-header {
    background: azul;
    color: branco;
    border-bottom: none;
    padding: 18px 24px;

    .modal-title {
      font-family: font-titulo;
      font-size: 19px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;

      img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        filter: invert(1) brightness(2);
      }
    }

    .btn-close {
      filter: invert(1);
      opacity: 0.85;
    }
  }

  .modal-body {
    background: azul;
    color: branco;
    padding: 16px 24px 28px;
    font-family: font-base;
    font-size: 16px;
    line-height: 1.75;

    p {
      margin-bottom: 12px;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }
}

// ============================================================
// Modal Saiba Mais (green)
// ============================================================
.modal-saibamais {
  .modal-dialog {
    max-width: 600px;
  }

  .modal-content {
    border: none;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.18);
  }

  .modal-header {
    background: verde;
    color: branco;
    border-bottom: none;
    padding: 16px 24px;

    .modal-title {
      font-family: font-titulo;
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;

      img {
        width: 24px;
        height: 24px;
        object-fit: contain;
        filter: invert(1) brightness(2);
      }
    }

    .btn-close {
      filter: invert(1);
      opacity: 0.85;
    }
  }

  .modal-body {
    padding: 22px 24px;
    font-family: font-base;
    font-size: 15px;
    line-height: 1.75;
    color: #1a1a1a;

    p {
      margin-bottom: 12px;
    }

    h3 {
      font-family: font-titulo;
      font-size: 16px;
      font-weight: 700;
      color: verde-escuro;
      margin-bottom: 8px;
      margin-top: 18px;
    }

    ul {
      padding-left: 20px;

      li {
        margin-bottom: 6px;
      }
    }

    .saibamais-ref {
      font-size: 13px;
      color: cinza-texto;
      border-top: 1px solid cinza-claro;
      padding-top: 12px;
      margin-top: 16px;
    }
  }
}

// ============================================================
// Info strip (INFOS section inside semana)
// ============================================================
.info-strip {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 16px;
  background: #f0f6ff;
  border-left: 3px solid azul;
  border-radius: 0 6px 6px 0;
  margin: 12px 0;
  font-size: 14px;
  line-height: 1.6;
  color: #1a1a1a;

  .info-icone {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-top: 2px;

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }
}
